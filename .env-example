DISCORD_TOKEN=your-discord-token
CLIENT_ID=your-client-id

LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=your-password
# Optional, comma-separated HTTPS hosts for trusted radio/direct media. Leave empty to allow only built-in providers.
ALLOWED_DIRECT_MEDIA_HOSTS=

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_secret
SPOTIFY_SP_DC=your_spotify_sp_dc_cookie

DEEZER_ARL_TOKEN=your_deezer_arl_token
DEEZER_MASTER_KEY=g4el58wc0zvf9na1

YOUTUBE_PO_TOKEN=your_po_token
YOUTUBE_VISITOR_DATA=your_visitor_data
YOUTUBE_REFRESH_TOKEN=your_refresh_token
YT_CIPHER_API_TOKEN=generate-a-long-random-secret-for-the-self-hosted-cipher

GENIUS_API_KEY=your_genius_api_key

# Optional, but strongly recommended for smart autoplay genre/vibe matching.
LASTFM_APPLICATION_NAME=your_lastfm_application_name
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_SHARED_SECRET=your_lastfm_shared_secret

INACTIVITY_TIMEOUT_MS=300000 # default 5 minutes
TRACK_START_TIMEOUT_MS=15000 # recover a queue item that never emits TrackStart
DEFAULT_VOLUME=50 # default volume 50%
LOUDNESS_NORMALIZATION=true # apply conservative provider volume compensation
# Optional per-provider overrides in dB, e.g. LOUDNESS_SOUNDCLOUD_DB=-3
PLAYER_RECOVERY_MAX_AGE_MS=7200000 # restore an unexpected disconnect snapshot for up to two hours
HISTORY_RETENTION_DAYS=180 # remove older per-user search history entries
STATS_RETENTION_DAYS=365 # remove older per-user daily listening stats
SEARCH_CACHE_MAX_ENTRIES=240 # bounded in-memory Activity/autocomplete search cache
SEARCH_SUGGESTIONS=true # correct misspelt searches with YouTube's query suggestions; false keeps queries as typed
PROGRESS_UPDATE_INTERVAL_MS=0 # default progress update interval 0ms
LYRICS_SYNC_OFFSET_MS=-450 # delay lyric highlighting to align with Discord voice playback
# Activity sends an immediate event for player/queue changes and a small
# reconciliation snapshot at this interval while it is open.
ACTIVITY_STATE_HEARTBEAT_MS=1500
# --- Autoplay (AI-first) ---
# The OpenAI director picks the next track; provider candidates are its menu,
# and the deterministic ladder below only runs when AI is disabled or fails.
AUTOPLAY_HISTORY_LIMIT=80 # recent autoplay cooldown window
AUTOPLAY_REPEAT_COOLDOWN_MS=3600000 # block duplicate tracks during short sessions; allow a natural return after one hour
AUTOPLAY_EXPOSURE_TTL_MS=1209600000 # persistent recommendation memory, 14 days
AUTOPLAY_EXPOSURE_LIMIT=300 # max canonical tracks remembered per guild
LASTFM_AUTOPLAY_FETCH_LIMIT=18 # similar tracks requested from Last.fm
LASTFM_AUTOPLAY_RESOLVE_LIMIT=12 # similar tracks resolved through Lavalink
AUTOPLAY_DEEZER_METADATA=true # enrich autoplay candidates with public Deezer BPM/gain metadata
AUTOPLAY_DEEZER_METADATA_LIMIT=18 # maximum candidates checked per autoplay cycle
AUTOPLAY_DEEZER_METADATA_CACHE_TTL_MS=604800000 # cache catalog metadata for 7 days
SURPRISE_ME_TRENDING_CACHE_TTL_MS=900000 # cache the free Deezer global chart for 15 minutes
AUTOPLAY_METADATA_TIMEOUT_MS=3500 # timeout for a non-critical metadata lookup
AUTOPLAY_RESOLVE_TIMEOUT_MS=12000 # per-provider autoplay/fallback resolver timeout
AUTOPLAY_COMMUNITY_METADATA=true # enrich the active/manual seed with free community tags
AUTOPLAY_COMMUNITY_METADATA_CACHE_TTL_MS=2592000000 # cache community metadata for 30 days
AUTOPLAY_COMMUNITY_METADATA_TIMEOUT_MS=4000 # timeout per non-critical community lookup
AUTOPLAY_COMMUNITY_METADATA_MIN_TAGS=2 # skip lower-priority sources once enough tags are known
AUTOPLAY_MUSICBRAINZ=true # verify sparse recordings against MusicBrainz (no key required)
AUTOPLAY_MUSICBRAINZ_MIN_INTERVAL_MS=1100 # respect MusicBrainz's public API rate limit
AUTOPLAY_THEAUDIODB=true # fill sparse genre/mood metadata from TheAudioDB
THEAUDIODB_API_KEY=2 # TheAudioDB public development key; replace if you have your own key
AUTOPLAY_MANUAL_MEMORY_LIMIT=40 # durable user-selected taste memory shared with the AI DJ
AUTOPLAY_PENDING_MANUAL_CONTEXT_LIMIT=4 # upcoming manual queue tracks used to shape the next recommendation

# Emergency ladder caps - never applied to AI director picks. A distinctive
# artist may run as long as the director keeps rating the continuation high;
# these caps only stop the deterministic fallback from walking one album.
AUTOPLAY_V3_MAX_ALBUM_STREAK=2 # fallback: maximum consecutive tracks from one album
AUTOPLAY_V3_MAX_ARTIST_STREAK=3 # fallback: maximum consecutive tracks by one artist
AUTOPLAY_V3_MAX_ALBUM_CONTINUITY_STREAK=3 # fallback emergency cap for a strong album run
AUTOPLAY_V3_MAX_ARTIST_CONTINUITY_STREAK=6 # fallback emergency cap for a strong artist run
AUTOPLAY_V3_SOFT_ARTIST_STREAK=4 # fallback: bridges start gaining weight after this streak
AUTOPLAY_V3_SOFT_ALBUM_STREAK=3 # fallback: exits start gaining weight after this streak
AUTOPLAY_SKIP_GENRE_PENALTY_MAX=30 # cap learned genre penalty in the fallback scorer

# --- AI DJ director ---
AI_DJ_ENABLED=false # have OpenAI act as the sole autoplay music director
OPENAI_API_KEY=your_openai_api_key # never commit the real key
AI_DJ_MODEL=gpt-6-luna # fast Responses API model that directs MewBit's next-track plans
AI_DJ_REASONING_EFFORT=low # GPT-5.6 reasoning depth; low keeps transitions responsive
AI_DJ_TIMEOUT_MS=12000 # falls back to the deterministic ladder on timeout or API error
AI_DJ_CACHE_TTL_MS=300000 # reuse an identical context decision for 5 minutes
AI_DJ_MAX_PROPOSALS=8 # maximum exact recordings the AI director can propose per transition
AI_DJ_WEB_SEARCH=false # optional paid web lookup; provider resolution still verifies every proposal
AI_DJ_MIN_CONFIDENCE=0.55 # low-confidence plans leave the deterministic ladder as the fallback
AI_DJ_MIN_FIT=55 # proposals under this fit are dropped individually, not the whole plan
AI_DJ_DIVERSITY_FIT_BAND=10 # weighted-random rotation band around the best-fit proposal
AI_DJ_SKIP_DEMOTION=12 # weight lost per recent skip of a proposed artist (soft demotion)
FAST_LOGS=1 # enable fast logging
LOG_TO_FILE=1 # enable file logging

# --- Dashboard (web settings surface) ---
DASHBOARD_ENABLED=true
# Public origin the dashboard and landing page are served from. Used for the
# OAuth redirect, the post-login redirect, and the write-origin check.
DASHBOARD_PUBLIC_URL=http://localhost:5174
# Leave this empty. It derives from DASHBOARD_PUBLIC_URL above, so a
# deployment only sets one value and the derived URI is printed at startup.
# Set it only when the callback is served somewhere other than the site
# origin. Either way the value must be registered as a redirect URI in the
# Discord application's OAuth2 settings.
DASHBOARD_OAUTH_REDIRECT_URI=
# Session lifetime in ms. Default 7 days. Sessions are in-memory and do not
# survive a bot restart.
DASHBOARD_SESSION_TTL_MS=604800000
# How many reverse proxies sit in front of the gateway. 0 (the default) means
# none, and X-Forwarded-For is ignored because anyone can forge it. Set it to 1
# behind a single proxy such as a Cloudflare tunnel: without it every visitor
# shares one rate-limit bucket and any one of them can lock out the rest.
DASHBOARD_TRUST_PROXY=0
