{
  "name": "mewbit",
  "version": "1.4.0",
  "description": "mewbit — a neon cyberpunk Discord music bot with smart autoplay, DJ mode, statistics, and persistent EQ settings",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:dev": "dotenv -e .env.dev -- pnpm start",
    "start:prod": "dotenv -e .env.prod -- pnpm start",
    "docker:prod": "docker compose up -d --build",
    "docker:build": "docker buildx build --platform linux/arm64 -t marczelloo/neo-beat-buddy:latest --push .",
    "local:up": "docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build",
    "local:down": "docker compose -f docker-compose.yml -f docker-compose.local.yml down",
    "local:restart": "docker compose -f docker-compose.yml -f docker-compose.local.yml restart bot",
    "local:logs": "docker compose -f docker-compose.yml -f docker-compose.local.yml logs -f bot",
    "deploy": "node deploy-commands.js",
    "deploy:dev": "dotenv -e .env.dev -- node deploy-commands.js",
    "deploy:prod": "dotenv -e .env.prod -- node deploy-commands.js",
    "lavalink:dev": "docker compose -f helpers/lavalink/docker-compose.yml --env-file .env.dev up -d",
    "lavalink:dev:down": "docker compose -f helpers/lavalink/docker-compose.yml down",
    "lavalink:youtube:patch": "node scripts/build-youtube-tvua-plugin.mjs",
    "lint": "eslint . --ext .js,.cjs,.mjs,.jsx",
    "lint:fix": "eslint . --ext .js,.cjs,.mjs,.jsx --fix",
    "test": "node scripts/run-tests.js",
    "test:autoplay:soak": "node scripts/autoplay-soak.js",
    "test:autoplay:live": "node scripts/autoplay-live-soak.js",
    "test:watch": "node scripts/run-tests.js --watch",
    "test:autoplay": "node --test tests/helpers/lavalink/autoplayV3.test.js",
    "activity:dev": "pnpm --dir activity dev",
    "activity:build": "pnpm --dir activity build",
    "activity:lint": "eslint activity/src --ext .js,.jsx",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web build",
    "web:lint": "eslint web/src --ext .js,.jsx"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marczelloo/NeoBeat-Buddy.git"
  },
  "keywords": [
    "discord",
    "music-bot",
    "lavalink",
    "discord-bot",
    "music",
    "discord.js",
    "poru",
    "equalizer",
    "dj-mode",
    "statistics"
  ],
  "author": "Marczelloo",
  "bugs": {
    "url": "https://github.com/Marczelloo/NeoBeat-Buddy/issues"
  },
  "homepage": "https://github.com/Marczelloo/NeoBeat-Buddy#readme",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "cheerio": "^1.2.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "node-fetch": "^3.3.2",
    "poru": "^5.3.0",
    "shoukaku": "^4.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0"
  }
}
