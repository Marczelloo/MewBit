# Downloaded and derived bulk data: audio, .osz, features, API cache, wiki copies (CC BY-NC), scratch builds.
/data/
# The repository's root .gitignore ignores every folder named "data"; the stage-1 results here are meant to be kept.
!/shared/data/
# Per-slot tables are large and regenerated by the pipeline.
/shared/data/*/slots/
__pycache__/
# The root .gitignore drops every *.txt; the environment files are needed to reproduce the analysis.
!requirements*.txt
# ...and every *.sh: the per-level analyses ship their run scripts and text tables.
!*.sh
!*.txt
