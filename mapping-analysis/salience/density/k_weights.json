{
 "variant": "rel_os + meter on the generator grid (ctx.timing); chosen because no Features v4 proxy was within -.01 AUC of rel_os (rel_proxy.log)",
 "features": [
  "rel_os",
  "m_beat",
  "m_half",
  "m_quarter",
  "m_other",
  "m_down",
  "d_grid"
 ],
 "model": "sklearn LogisticRegression(C=1, max_iter=400); score = intercept + sum(coef[i] * x[i]); probability = 1 / (1 + exp(-score)); rank candidates by score",
 "inputs": {
  "rel_os": "librosa.onset.onset_strength (mel spectrogram, 22050 Hz, hop 256, n_fft 2048) divided by its uniform mean over 2 s (172 frames, edges repeated) plus 1e-6; then a maximum filter over 5 frames; sampled at the candidate time plus a per-song mel shift (extract.py build). The plugin has to supply it; Features v4 does not carry it.",
  "m_beat": "1 if the candidate lies within 0.07 of a beat period of a grid beat, else 0.",
  "m_half": "1 if within 0.07 of the half-beat position (and m_beat is 0), else 0.",
  "m_quarter": "1 if within 0.07 of a quarter-beat position (0.25 or 0.75; and m_beat, m_half are 0), else 0.",
  "m_other": "1 if none of m_beat, m_half, m_quarter, else 0.",
  "m_down": "1 if m_beat is 1 and the nearer of the two surrounding beats lies within 2 ms of a downbeat of the grid, else 0. 0 everywhere when the grid has no downbeats.",
  "d_grid": "distance to the nearest of the beat, half-beat and quarter-beat positions, as a fraction of the beat period (u = position in the beat in [0,1); min(u, 1-u, |u-0.5|, |u-0.25|, |u-0.75|)).",
  "meter": "Position in the beat: i = last grid beat at or before the candidate (clipped to the second-to-last beat), u = (t - beats[i]) / (beats[i+1] - beats[i]) mod 1. Grid = ctx.timing.beats / .downbeats of the generator.",
  "no_grid": "When the generator has no snapped grid (ctx.timing.snapped false) or fewer than 3 beats: m_other = 1 and every other meter column (m_beat, m_half, m_quarter, m_down, d_grid) = 0 for every candidate. 1 of the 80 train songs has no grid."
 },
 "rank": "Every column is turned into a within-song rank before scoring. Columns with more than 2 distinct values in the song: average rank (ties get the mean of their ranks, 1-based) divided by the number of candidates n of that song, so the values lie in (0, 1]. Columns with at most 2 distinct values (the binary meter flags, or a constant column) stay raw. Same as common.rank_cols; scipy.stats.rankdata(method='average') / n. The ranks are float32 in the fit; a port may use float64.",
